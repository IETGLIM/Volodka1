{
  "version": 2,
  "bootJsGzipBytes": {
    "target": 450000,
    "hardMax": 650000,
    "description": "JS for menu boot (before New Game — no WebGL / narrative blobs)"
  },
  "gameStartJsGzipBytes": {
    "target": 1200000,
    "hardMax": 1800000,
    "description": "Additional JS for first playable scene (canvas + three + narrative)"
  },
  "initialJsGzipBytes": {
    "target": 800000,
    "hardMax": 1200000,
    "description": "Deprecated alias: boot + gameStart cumulative budget (report only)"
  },
  "firstScenePlayableMs": {
    "target": 3000,
    "hardMax": 5000,
    "description": "Time from navigation start to canvas:first-frame + game data ready"
  },
  "fps": {
    "desktop": { "target": 60, "min": 55 },
    "weakLaptop": { "target": 45, "min": 30 },
    "sampleFrames": 120,
    "description": "Rolling average FPS; weak-laptop profile uses DPR <= 1.25 or hardwareConcurrency <= 4"
  },
  "drawCalls": {
    "defaultMax": 300,
    "warnRatio": 0.85,
    "perScene": {
      "volodka_room": 220,
      "volodka_corridor": 200,
      "home_evening": 280,
      "zarema_albert_room": 240,
      "street_night": 320,
      "street_winter": 340,
      "cafe_evening": 260,
      "office_day": 280,
      "park_day": 350,
      "library_day": 270,
      "rooftop_edge": 300,
      "abandoned_factory": 360,
      "chk_forest_zorge": 400,
      "battle": 420,
      "sleep_dream": 380
    }
  },
  "physicsStepMs": {
    "target": 2.5,
    "hardMax": 5,
    "description": "Rapier step wall time per frame"
  },
  "reactRendersPerFrame": {
    "warn": 3,
    "hardMax": 8
  },
  "zustandNotificationsPerFrame": {
    "warn": 5,
    "hardMax": 15
  },
  "cpuFrameMs": {
    "target": 16.67,
    "hardMax": 33.33,
    "description": "Wall frame time — 16.67 ms @ 60 FPS, 33.33 ms @ 30 FPS"
  },
  "gpuMemoryEstimateMb": {
    "target": 128,
    "hardMax": 256,
    "leakDriftWarnMb": 24,
    "leakDriftFailMb": 64,
    "sampleIntervalMs": 5000,
    "description": "Heuristic GPU buffer+texture estimate; drift vs per-scene baseline detects slow leaks"
  },
  "gpuResourceCounts": {
    "geometries": { "warn": 400, "hardMax": 800 },
    "textures": { "warn": 200, "hardMax": 400 }
  },
  "bundleTiers": {
    "boot": ["^index-", "^vendor-"],
    "bootMenu": [
      "^index-",
      "^vendor-",
      "^GameOrchestrator-",
      "^game-ui-menu-screen",
      "^boot-shared",
      "^data-loader",
      "^data-golden-path",
      "^data-npc",
      "^data-world",
      "^data-mechanics",
      "^data-misc",
      "^pack-chk-npc",
      "^pack-chk-world"
    ],
    "gameStart": [
      "^three-",
      "^r3f-",
      "^drei-",
      "^postfx-",
      "^game-canvas-",
      "^scene-volodka-room",
      "^data-story",
      "^data-dialogue",
      "^data-quests",
      "^data-poems",
      "^data-lore",
      "^data-narrative",
      "^content-validator",
      "^engine-narrative",
      "^engine-quest",
      "^pack-chk-narrative"
    ],
    "firstScene": [
      "^index-",
      "^vendor-",
      "^GameOrchestrator-",
      "^game-ui-menu-screen",
      "^boot-shared",
      "^data-loader",
      "^data-golden-path",
      "^data-npc",
      "^data-world",
      "^data-mechanics",
      "^data-misc",
      "^pack-chk-npc",
      "^pack-chk-world",
      "^three-",
      "^r3f-",
      "^drei-",
      "^postfx-",
      "^game-canvas-",
      "^scene-volodka-room",
      "^data-story",
      "^data-dialogue",
      "^data-quests",
      "^data-poems",
      "^data-lore",
      "^data-narrative",
      "^content-validator",
      "^engine-narrative",
      "^engine-quest",
      "^pack-chk-narrative"
    ],
    "lazyPrefixes": [
      "^physics-",
      "^physics-scene-",
      "^minigame-",
      "^panel-",
      "^game-ui-(?!menu-screen|hud)",
      "^scene-(?!volodka-room)",
      "^game-dev",
      "^engine-combat"
    ]
  }
}
