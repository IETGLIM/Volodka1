#pragma kernel KGenerateMaps

RWTexture2D<float4> _BaseColor;
RWTexture2D<float4> _NormalMap;
RWTexture2D<float4> _MaskMap; // R = metallic, G = roughness, B = AO
RWTexture2D<float4> _HeightMap;

int _Resolution;
float _Seed;
float4 _WorldOrigin;
float _PatternScale;
float _MaterialMode; // 0 stone, 1 metal, 2 wood, 3 skin

float hash21(float2 p)
{
    p = frac(p * float2(123.34, 345.45));
    p += dot(p, p + 34.345);
    return frac(p.x * p.y);
}

float valueNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1, 0));
    float c = hash21(i + float2(0, 1));
    float d = hash21(i + float2(1, 1));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p)
{
    float sum = 0.0;
    float amplitude = .5;
    [unroll] for (int i = 0; i < 6; i++)
    {
        sum += valueNoise(p) * amplitude;
        p = p * 2.02 + 17.13;
        amplitude *= .5;
    }
    return sum;
}

float worley(float2 p)
{
    float2 cell = floor(p);
    float2 local = frac(p);
    float closest = 3.0;
    [unroll] for (int y = -1; y <= 1; y++)
    [unroll] for (int x = -1; x <= 1; x++)
    {
        float2 offset = float2(x, y);
        float2 feature = float2(hash21(cell + offset), hash21(cell + offset + 19.7));
        closest = min(closest, length(offset + feature - local));
    }
    return closest;
}

float Height(float2 uv)
{
    float2 p = (uv + _WorldOrigin.xz * .013 + _Seed * .071) * _PatternScale * 18.0;
    float n = fbm(p);
    float cells = worley(p * 1.25);
    float grain = sin((p.x + n * 2.0) * 10.0) * .5 + .5;
    if (_MaterialMode < .5) return n * .72 + (1.0 - cells) * .28;                 // stone
    if (_MaterialMode < 1.5) return n * .32 + sin(p.x * 7.0 + p.y * 2.0) * .12;  // metal
    if (_MaterialMode < 2.5) return grain * .75 + n * .25;                        // wood
    return n * .18 + (1.0 - cells) * .07;                                         // skin
}

[numthreads(8, 8, 1)]
void KGenerateMaps(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;
    float2 uv = (id.xy + .5) / _Resolution;
    float height = Height(uv);
    float eps = 1.0 / _Resolution;
    float hx = Height(uv + float2(eps, 0));
    float hy = Height(uv + float2(0, eps));
    float3 normal = normalize(float3((height - hx) * 10.0, (height - hy) * 10.0, 1.0));

    float cells = worley((uv + _Seed) * _PatternScale * 22.0);
    float metallic = _MaterialMode > .5 && _MaterialMode < 1.5 ? saturate(.55 + height * .4) : 0.0;
    float roughness = _MaterialMode < .5 ? .7 + cells * .22 : (_MaterialMode < 1.5 ? .22 + cells * .25 : (_MaterialMode < 2.5 ? .58 : .62));
    float ao = saturate(.6 + height * .45);
    float3 color;
    if (_MaterialMode < .5) color = lerp(float3(.16,.18,.19), float3(.48,.43,.36), height + cells * .18);
    else if (_MaterialMode < 1.5) color = lerp(float3(.06,.10,.12), float3(.42,.48,.50), height);
    else if (_MaterialMode < 2.5) color = lerp(float3(.09,.035,.012), float3(.43,.20,.06), height);
    else color = lerp(float3(.24,.08,.05), float3(.78,.38,.25), height + .3);

    _BaseColor[id.xy] = float4(color, 1);
    _NormalMap[id.xy] = float4(normal * .5 + .5, 1);
    _MaskMap[id.xy] = float4(metallic, roughness, ao, 1);
    _HeightMap[id.xy] = float4(height.xxx, 1);
}