{
  "name": "volodka-rpg",
  "version": "4.2.43",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:inspect": "vite --mode inspect",
    "build": "vite build",
    "build:full": "npm run assets:prepare && npm run validate && npm run assets:validate && node scripts/tsc7.mjs -b && vite build && npx tsx --tsconfig tsconfig.json scripts/prune-deploy-assets.ts && npm run budgets && npm run verify:deploy",
    "build:analyze": "npm run validate && node scripts/tsc7.mjs -b && vite build --mode analyze && npm run budgets",
    "validate": "npx tsx --tsconfig tsconfig.json scripts/validate-content.ts && npx tsx --tsconfig tsconfig.json scripts/verify-act1-extended.ts",
    "validate:content": "npx tsx --tsconfig tsconfig.json scripts/validate-content.ts",
    "validate:act1-extended": "npx tsx --tsconfig tsconfig.json scripts/verify-act1-extended.ts",
    "assets:bootstrap": "node scripts/bootstrap-production-assets.mjs",
    "assets:sync-shipped": "npx tsx --tsconfig tsconfig.json scripts/sync-asset-shipped-flags.ts",
    "assets:prepare": "npm run assets:bootstrap && npm run assets:polyhaven-models && npm run assets:process-catalog && npm run assets:sync-shipped",
    "assets:process-catalog": "node scripts/process-catalog-assets.mjs",
    "assets:status": "npx tsx --tsconfig tsconfig.json scripts/assets-status.mjs",
    "assets:process": "node scripts/process-gltf-assets.mjs",
    "assets:polyhaven-models": "node scripts/download-polyhaven-models.mjs",
    "assets:ai3dgen-import": "node scripts/ai3dgen-import.mjs",
    "assets:quaternius-import": "node scripts/quaternius-import.mjs",
    "assets:npc-composer": "node scripts/npc-composer.mjs",
    "assets:freekit-stage": "node scripts/stage-freekit-assets.mjs",
    "assets:rpm-import": "node scripts/rpm-npc-import.mjs",
    "assets:mixamo-import": "node scripts/mixamo-import.mjs",
    "assets:extract-animations": "node scripts/extract-quaternius-animations.mjs",
    "assets:ual-import": "node scripts/extract-ual-animations.mjs --download",
    "assets:kaykit-sleep-import": "node scripts/extract-kaykit-sleep-animation.mjs",
    "assets:optimize-animations": "node scripts/optimize-animation-glbs.mjs",
    "assets:validate": "npx tsx --tsconfig tsconfig.json scripts/validate-gltf-assets.ts",
    "assets:validate-lod": "node scripts/validate-lod-effectiveness.mjs",
    "assets:report-dupes": "node scripts/report-model-duplicates.mjs",
    "assets:prune-shared-npcs": "node scripts/prune-shared-npc-meshes.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "node scripts/tsc7.mjs --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "events:check": "node scripts/check-event-map.mjs",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run validate:content && npm run assets:validate && npm run build && npm run verify:deploy",
    "budgets": "node scripts/check-bundle-budgets.mjs --report",
    "budgets:check": "node scripts/check-bundle-budgets.mjs",
    "deploy:archive": "node scripts/create-deploy-archive.mjs",
    "verify:deploy": "npx tsx --tsconfig tsconfig.json scripts/verify-deploy-assets.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@react-three/rapier": "2.2.0",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fastnoise-lite": "^1.1.1",
    "framer-motion": "^12.23.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "postprocessing": "6.39.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^3.0.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.172.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@gltf-transform/cli": "^4.4.1",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.172.0",
    "@types/uuid": "11.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
